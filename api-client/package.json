{
  "name": "@iris-portico/api-client",
  "version": "1.0.0",
  "description": "Framework-agnostic TypeScript client for the InterSystems IRIS SysAdmin API (/api/admin). Shared by all frontend variants (Angular / React / Vue).",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "gen-types": "node scripts/gen-types.js ../mainspec_v2.json src/types/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run typecheck && node --test test/client.test.js"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^22.0.0"
  }
}
